# ==============================================================================
# AIRTECH ENGINEERING CONSULTANCY — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit actual secrets, API keys, or production credentials to git.

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="AIRTECH HVAC & MEP Engineering Consultancy"
NEXT_PUBLIC_COMPANY_LOCATION="Kolkata, West Bengal, India"

# ------------------------------------------------------------------------------
# 2. SUPABASE (Central Backend & Database)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SERVER-SIDE ONLY: Service role key for admin tasks, OTP creation, & webhook processing
# NEVER expose this key in frontend code or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENT PROCESSING
# ------------------------------------------------------------------------------
# Found in Stripe Dashboard -> Developers -> API keys (Use test keys: pk_test_*, sk_test_*)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...
# Found in Stripe Dashboard -> Developers -> Webhooks (or `stripe listen --print-secret`)
STRIPE_WEBHOOK_SECRET=whsec_...
# Set to 'inr' for domestic Indian transactions, or 'usd' for export billing
STRIPE_CURRENCY=inr

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (Resend / SMTP)
# ------------------------------------------------------------------------------
# Used for server-side 6-digit OTP delivery, invoice notifications, and payment receipts
EMAIL_PROVIDER_API_KEY=re_123456789...
EMAIL_FROM_ADDRESS="AIRTECH Engineering <notifications@airtech-mep.com>"
EMAIL_REPLY_TO="support@airtech-mep.com"

# ------------------------------------------------------------------------------
# 5. INDIAN STATUTORY & BANKING (For Manual Invoices & Tax Calculations)
# ------------------------------------------------------------------------------
COMPANY_GSTIN=19AABCA1234F1Z5
COMPANY_PAN=AABCA1234F
COMPANY_BANK_NAME="State Bank of India"
COMPANY_BANK_ACCOUNT_NO="123456789012"
COMPANY_BANK_IFSC="SBIN0001234"
COMPANY_BANK_BRANCH="Rajarhat Branch, Kolkata"
COMPANY_UPI_ID="airtechmep@sbi"

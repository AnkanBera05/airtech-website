# ==============================================================================
# AIRTECH ENGINEERING CONSULTANCY — PRODUCTION & LOCAL CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local testing.
# In Vercel, add these variables in Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN (Vercel & Spaceship)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://airtech-website-gules.vercel.app
NEXT_PUBLIC_COMPANY_NAME="AIRTECH HVAC & MEP Engineering Consultancy"
NEXT_PUBLIC_COMPANY_LOCATION="Kolkata, West Bengal, India"

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (Single Source of Truth for Identity & MFA)
# ------------------------------------------------------------------------------
# Obtain from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/owner/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal-access
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/register/submitted

# ------------------------------------------------------------------------------
# 3. SUPABASE (PostgreSQL Database & Secure Storage)
# ------------------------------------------------------------------------------
# Obtain from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side ONLY: NEVER prefix with NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 4. RESEND (Transactional Email & Operational Notifications)
# ------------------------------------------------------------------------------
# Obtain from Resend Dashboard -> API Keys (https://resend.com)
RESEND_API_KEY=re_123456789...
RESEND_FROM_EMAIL="AIRTECH Engineering <notifications@airtech-mep.com>"
ADMIN_NOTIFICATION_EMAIL=bera.ankan005@gmail.com

# ------------------------------------------------------------------------------
# 5. SENTRY ERROR MONITORING
# ------------------------------------------------------------------------------
# Obtain from Sentry Dashboard -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# 6. POSTHOG PRODUCT ANALYTICS
# ------------------------------------------------------------------------------
# Obtain from PostHog Project Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------------------------
# 7. STRIPE PAYMENT PROCESSING (Dual Flow: Card Checkout & Bank UTR)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=inr

# ------------------------------------------------------------------------------
# 8. STATUTORY TAXATION & BANKING PARAMETERS
# ------------------------------------------------------------------------------
COMPANY_GSTIN=19AABCA1234F1Z5
COMPANY_PAN=AABCA1234F
COMPANY_BANK_NAME="State Bank of India"
COMPANY_BANK_ACCOUNT_NO="123456789012"
COMPANY_BANK_IFSC="SBIN0001234"
COMPANY_BANK_BRANCH="Rajarhat Branch, Kolkata"
COMPANY_UPI_ID="airtechmep@sbi"
